# Optional SumoPod grounded AI. Keep the real key in ignored .env, never in the browser or Git.
# SUMOPOD_API_KEY=sk-...
# SUMOPOD_MODEL=gpt-5-mini
# Optional environment override; export before starting the API.
# CONTROLCHECK_DB=E:/project/ControlCheck-V2/data/local/controlcheck.db
# Required only for MPP import. Use a Java 17+ runtime installation path.
# CONTROLCHECK_JAVA_HOME=C:/Program Files/Eclipse Adoptium/jdk-17
# Optional browser origins permitted to call a locally hosted API through a tunnel.
# CONTROLCHECK_ALLOWED_ORIGINS=https://your-controlcheck.vercel.app
# Optional Vercel preview origin pattern for a short-lived demo tunnel.
# CONTROLCHECK_ALLOWED_ORIGIN_REGEX=https://web-[a-z0-9-]+-ekosuryahadis-projects\\.vercel\\.app
# Optional public API URL embedded into the Vite production build. Do not include /api.
# VITE_API_URL=https://random-name.trycloudflare.com
